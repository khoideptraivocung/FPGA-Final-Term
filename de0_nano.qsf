# ============================================================================
# Quartus Settings File (QSF) for Terasic DE0-Nano (Cyclone IV E)
# Device: EP4CE22F17C6
# IO Standard: 3.3-V LVTTL
# Project: Topic 22 - Sensor Digital Filter (MA & FIR)
# ============================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY top_de0_nano
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 13.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# SDC Timing Constraints
set_global_assignment -name SDC_FILE de0_nano.sdc

# RTL Source Files
set_global_assignment -name VERILOG_FILE rtl/sensor_filter_core.v
set_global_assignment -name VERILOG_FILE rtl/rom_sensor_reader.v
set_global_assignment -name VERILOG_FILE rtl/uart_tx.v
set_global_assignment -name VERILOG_FILE rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE rtl/seg7_3digit_controller.v
set_global_assignment -name VERILOG_FILE rtl/top_de0_nano.v

# ----------------------------------------------------------------------------
# 1. On-board Clock 50 MHz
# ----------------------------------------------------------------------------
set_location_assignment PIN_R8 -to CLOCK_50

# ----------------------------------------------------------------------------
# 2. On-board Push Buttons (Active-Low)
# ----------------------------------------------------------------------------
set_location_assignment PIN_J15 -to KEY[0]
set_location_assignment PIN_E1 -to KEY[1]

# ----------------------------------------------------------------------------
# 3. On-board DIP Switches
# ----------------------------------------------------------------------------
set_location_assignment PIN_M1 -to SW[0]
set_location_assignment PIN_T8 -to SW[1]
set_location_assignment PIN_B9 -to SW[2]

# ----------------------------------------------------------------------------
# 4. On-board 8 Green LEDs (Active-High)
# ----------------------------------------------------------------------------
set_location_assignment PIN_A15 -to LED[0]
set_location_assignment PIN_A13 -to LED[1]
set_location_assignment PIN_B13 -to LED[2]
set_location_assignment PIN_A11 -to LED[3]
set_location_assignment PIN_D1 -to LED[4]
set_location_assignment PIN_F3 -to LED[5]
set_location_assignment PIN_B1 -to LED[6]
set_location_assignment PIN_L3 -to LED[7]

# ----------------------------------------------------------------------------
# 5. External Peripherals via Header JP1 (GPIO-0)
# ----------------------------------------------------------------------------
# UART Interface
set_location_assignment PIN_D3 -to UART_RX
set_location_assignment PIN_C3 -to UART_TX

# 7-Segment Segments a..g
set_location_assignment PIN_A2 -to SEG[0]
set_location_assignment PIN_A3 -to SEG[1]
set_location_assignment PIN_B3 -to SEG[2]
set_location_assignment PIN_B4 -to SEG[3]
set_location_assignment PIN_A4 -to SEG[4]
set_location_assignment PIN_B5 -to SEG[5]
set_location_assignment PIN_A5 -to SEG[6]

# 3-Digit Enables (DIG 1, DIG 2, DIG 3)
set_location_assignment PIN_D5 -to DIG[2]
set_location_assignment PIN_B6 -to DIG[1]
set_location_assignment PIN_A6 -to DIG[0]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top